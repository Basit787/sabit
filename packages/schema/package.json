{
  "name": "@sabit/schema",
  "version": "0.0.0",
  "description": "Mongoose-style request schemas for sabit routes, validated with Zod.",
  "license": "MIT",
  "author": {
    "name": "Basit Saleem",
    "email": "basitsaleem282@gmail.com",
    "url": "https://github.com/Basit787"
  },
  "homepage": "https://github.com/Basit787/backend-file-based-routing/tree/main/packages/schema#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Basit787/backend-file-based-routing.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/Basit787/backend-file-based-routing/issues"
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "sabit",
    "schema",
    "validation",
    "zod",
    "mongoose"
  ],
  "exports": {
    ".": {
      "@sabit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
