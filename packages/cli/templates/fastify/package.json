    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jiti": "^2.6.1",
    "prettier": "^3.4.2",
    "sabit": "{{kit}}",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
