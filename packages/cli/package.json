{
  "name": "sabit",
  "version": "0.0.0",
  "description": "The sabit command line: create projects, scaffold REST endpoints, run the dev server, list routes.",
  "license": "MIT",
  "author": {
    "name": "Basit Saleem",
    "email": "basitsaleem282@gmail.com",
    "url": "https://github.com/Basit787"
  },
  "homepage": "https://github.com/Basit787/backend-file-based-routing/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Basit787/backend-file-based-routing.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Basit787/backend-file-based-routing/issues"
  },
  "type": "module",
  "keywords": [
    "sabit",
    "cli",
    "file-based-routing",
    "scaffold"
  ],
  "bin": {
    "sabit": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "@sabit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "templates"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "@sabit/router": "workspace:^"
  },
  "devDependencies": {
    "@sabit/schema": "workspace:^",
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
