{
  "name": "@sabit/router",
  "version": "0.0.0",
  "description": "Framework-agnostic file-based routing engine for backend frameworks.",
  "license": "MIT",
  "author": {
    "name": "Basit Saleem",
    "email": "basitsaleem282@gmail.com",
    "url": "https://github.com/Basit787"
  },
  "homepage": "https://github.com/Basit787/backend-file-based-routing/tree/main/packages/router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Basit787/backend-file-based-routing.git",
    "directory": "packages/router"
  },
  "bugs": {
    "url": "https://github.com/Basit787/backend-file-based-routing/issues"
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "router",
    "file-based-routing",
    "backend",
    "express",
    "hono",
    "fastify",
    "nestjs"
  ],
  "exports": {
    ".": {
      "@sabit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fs": {
      "@sabit/source": "./src/fs/index.ts",
      "types": "./dist/fs/index.d.ts",
      "default": "./dist/fs/index.js"
    },
    "./node": {
      "@sabit/source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "zod": "4.6.7"
  }
}
